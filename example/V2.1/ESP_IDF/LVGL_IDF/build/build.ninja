  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D "G:\basic HMI\4.3inch\ESP_IDF\LVGL_IDF\build\esp-idf\spiffs" && C:\Espressif\tools\cmake\3.30.2\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
